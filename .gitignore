# 依赖与构建产物（本仓库刻意保持零依赖、零构建，这里只防手滑）
node_modules/
dist/
*.log

# Python 运行缓存（tools/serve.py 之类会顺手生成）
__pycache__/

# 编辑器 / IDE 与 AI 助手本地数据
.codebuddy/
.vscode/
.idea/
.playwright-cli/

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini

# 本地临时文件
*.tmp
*.bak

# 本地旁路服务（sidecar）运行时数据：config.json / token / SQLite / 锁文件
sidecar/data/

# 本地视觉预览草稿（文件头已注明「验证完可删除」）
_note-preview.html

# 手动验收证据（截图 / 报告 / 网络日志 / DOM 快照）：不进仓库
acceptance/
